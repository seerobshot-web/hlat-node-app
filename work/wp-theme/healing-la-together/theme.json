{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Healing Los Angeles Together",
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "80rem",
			"wideSize": "90rem"
		},
		"color": {
			"palette": [
				{
					"slug": "background",
					"name": "Background",
					"color": "#f7f8f8"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#dfe5e8"
				},
				{
					"slug": "navy-text",
					"name": "Navy Text",
					"color": "#12304a"
				},
				{
					"slug": "navy-muted",
					"name": "Muted Navy",
					"color": "#526472"
				},
				{
					"slug": "navy",
					"name": "Navy",
					"color": "#0b3768"
				},
				{
					"slug": "navy-deep",
					"name": "Deep Navy",
					"color": "#073667"
				},
				{
					"slug": "navy-darkest",
					"name": "Darkest Navy",
					"color": "#052b55"
				},
				{
					"slug": "gold",
					"name": "Amber",
					"color": "#d4a017"
				},
				{
					"slug": "gold-accent",
					"name": "Amber Accent",
					"color": "#d4a017"
				},
				{
					"slug": "gold-muted",
					"name": "Amber Muted",
					"color": "#b8860f"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#ffffff"
				}
			],
			"gradients": [],
			"custom": true,
			"customGradient": true,
			"defaultPalette": false
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "'Inter', ui-sans-serif, system-ui, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Fraunces",
					"fontFamily": "'Fraunces', ui-serif, Georgia, serif"
				}
			],
			"fontSizes": [
				{
					"slug": "eyebrow",
					"name": "Eyebrow",
					"size": "0.625rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem"
				},
				{
					"slug": "x-large",
					"name": "X-Large",
					"size": "1.875rem"
				},
				{
					"slug": "xx-large",
					"name": "XX-Large",
					"size": "2.25rem"
				},
				{
					"slug": "huge",
					"name": "Huge",
					"size": "3rem"
				},
				{
					"slug": "giant",
					"name": "Giant",
					"size": "3.75rem"
				}
			],
			"fontWeights": true,
			"lineHeight": true
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1.25rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "2rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "3rem"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "5rem"
				},
				{
					"slug": "70",
					"name": "XXL",
					"size": "7rem"
				}
			],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"border": {
			"radius": true,
			"color": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--navy-text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--small)",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600"
				},
				"color": {
					"text": "var(--wp--preset--color--navy-text)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--gold-muted)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--navy)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "9999px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--eyebrow)",
					"fontWeight": "700",
					"letterSpacing": "0.16em",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--gold)",
						"text": "var(--wp--preset--color--navy-text)"
					}
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": []
}
